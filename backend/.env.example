# Environment Configuration for CallerLog Backend

# Database Configuration:
# Leave blank to use the built-in local SQLite database (zero setup required)
# Or set your Supabase Postgres connection string (e.g., postgresql://postgres:password@db.xxx.supabase.co:5432/postgres)
DATABASE_URL=

# Google Gemini API Key:
# Optional: Get a free key from https://aistudio.google.com/
# If left blank, CallerLog uses an intelligent local heuristic analysis engine.
GEMINI_API_KEY=

# Server Configuration:
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
